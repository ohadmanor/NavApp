{
  "name": "navapp-outdoor",
  "private": true,
  "version": "1.0.0",
  "description": "Serverless Offline-First Cross-Platform Outdoor Map Navigation (Web PWA, Android, iOS) powered by MapLibre GL JS & PMTiles",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host",
    "test": "vitest run",
    "fetch-pois": "node devops/fetch-israel-pois.mjs",
    "generate-assets": "node devops/generate-offline-assets.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@turf/turf": "^7.2.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "maplibre-contour": "^0.0.8",
    "maplibre-gl": "^5.1.0",
    "pmtiles": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
