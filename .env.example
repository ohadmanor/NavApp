# Firebase Web App Configuration (Project: navapp-israel-topo)
# Obtain these values from Firebase Console -> Project Settings -> Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=navapp-israel-topo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=navapp-israel-topo
VITE_FIREBASE_STORAGE_BUCKET=navapp-israel-topo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: self-hosted Nginx / custom CDN origin for /data/* (use "same-origin" when Nginx serves both dist/ and data/)
# VITE_DATA_ORIGIN=same-origin
# Optional: override URL for Israel.dem.pmtiles (e.g. Firebase Storage or Cloudflare R2) for fast >1GB range requests
# VITE_DEM_PMTILES_URL=https://firebasestorage.googleapis.com/v0/b/navapp-israel-topo.firebasestorage.app/o/map_data%2FIsrael.dem.pmtiles?alt=media

# Optional: Static Web OSM Sync UI (/osm-sync & /osm-callback under Nginx or Firebase Hosting)
# Register an OAuth 2.0 application (non-confidential, write_api scope) with Redirect URI: https://<your-domain>/osm-callback
# VITE_OSM_CLIENT_ID=
# VITE_OSM_SANDBOX_CLIENT_ID=

# Optional: External PC OSM Sync Tool (devops/sync-osm-roads.bat)
# Create an OAuth 2.0 application on openstreetmap.org (or master.apis.dev.openstreetmap.org for sandbox) with write_api scope:
# OSM_ACCESS_TOKEN=
# OSM_CLIENT_ID=
