{
  "firestore": {
    "rules": "devops/firebase/firestore.rules",
    "indexes": "devops/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "devops/firebase/storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": [
    {
      "target": "app",
      "public": "devops/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.apk",
        "**/*.exe",
        "**/*.bat",
        "**/*.sh"
      ],
      "rewrites": [
        {
          "source": "!/data/**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.pmtiles",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, HEAD, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Range, If-Match, Content-Type"
            },
            {
              "key": "Access-Control-Expose-Headers",
              "value": "Accept-Ranges, Content-Range, Content-Length, ETag"
            },
            {
              "key": "Accept-Ranges",
              "value": "bytes"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "target": "data",
      "public": "deploy_data",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.pmtiles",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, HEAD, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Range, If-Match, Content-Type"
            },
            {
              "key": "Access-Control-Expose-Headers",
              "value": "Accept-Ranges, Content-Range, Content-Length, ETag"
            },
            {
              "key": "Accept-Ranges",
              "value": "bytes"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.geojson",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, HEAD, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Range, If-Match, Content-Type"
            },
            {
              "key": "Access-Control-Expose-Headers",
              "value": "Accept-Ranges, Content-Range, Content-Length, ETag"
            },
            {
              "key": "Accept-Ranges",
              "value": "bytes"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**/*.idx",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, HEAD, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Range, If-Match, Content-Type"
            },
            {
              "key": "Access-Control-Expose-Headers",
              "value": "Accept-Ranges, Content-Range, Content-Length, ETag"
            },
            {
              "key": "Accept-Ranges",
              "value": "bytes"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    }
  ]
}
