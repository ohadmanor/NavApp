rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPoiDeleteAdmin() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in ['ohad.manor@gmail.com', 'nabibesk@gmail.com'];
    }

    function validPoiCategory(cat) {
      return cat in ['water', 'heritage', 'campsite', 'offroad', 'peak', 'user'];
    }

    function validBasePoiFields(data, poiId) {
      return data.id == poiId &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.nameHe is string &&
        data.nameHe.size() > 0 &&
        data.nameHe.size() <= 200 &&
        data.nameEn is string &&
        data.nameEn.size() <= 200 &&
        data.category is string &&
        validPoiCategory(data.category) &&
        data.subcategory is string &&
        data.subcategory.size() > 0 &&
        data.subcategory.size() <= 64 &&
        (data.lon is int || data.lon is float) &&
        data.lon >= -180 &&
        data.lon <= 180 &&
        (data.lat is int || data.lat is float) &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        (data.ele == null || data.ele is int || data.ele is float) &&
        (data.waterStatus == null || (data.waterStatus is string && data.waterStatus.size() <= 200)) &&
        (data.difficulty4x4 == null || (data.difficulty4x4 is string && data.difficulty4x4.size() <= 200)) &&
        data.descHe is string &&
        data.descHe.size() <= 4000 &&
        data.descEn is string &&
        data.descEn.size() <= 4000 &&
        data.source is string &&
        data.source.size() <= 200 &&
        data.createdByUid is string &&
        data.createdByUid.size() > 0 &&
        data.createdByUid.size() <= 128 &&
        data.createdAt is string &&
        data.createdAt.size() > 0 &&
        data.createdAt.size() <= 64 &&
        data.updatedByUid is string &&
        data.updatedByUid.size() > 0 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 64;
    }

    function validGlobalPoi(data, poiId) {
      return data.keys().hasOnly([
          'id',
          'name',
          'nameHe',
          'nameEn',
          'category',
          'subcategory',
          'lon',
          'lat',
          'ele',
          'waterStatus',
          'difficulty4x4',
          'descHe',
          'descEn',
          'source',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'name',
          'nameHe',
          'nameEn',
          'category',
          'subcategory',
          'lon',
          'lat',
          'ele',
          'waterStatus',
          'difficulty4x4',
          'descHe',
          'descEn',
          'source',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        validBasePoiFields(data, poiId);
    }

    function validPrivatePoi(data, poiId) {
      return data.keys().hasOnly([
          'id',
          'name',
          'nameHe',
          'nameEn',
          'category',
          'subcategory',
          'lon',
          'lat',
          'ele',
          'waterStatus',
          'difficulty4x4',
          'descHe',
          'descEn',
          'source',
          'visibility',
          'ownerUid',
          'ownerEmail',
          'ownerDisplayName',
          'sharedWith',
          'sharedWithUids',
          'sharedWithEmails',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'name',
          'nameHe',
          'nameEn',
          'category',
          'subcategory',
          'lon',
          'lat',
          'ele',
          'waterStatus',
          'difficulty4x4',
          'descHe',
          'descEn',
          'source',
          'visibility',
          'ownerUid',
          'ownerEmail',
          'ownerDisplayName',
          'sharedWith',
          'sharedWithUids',
          'sharedWithEmails',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        validBasePoiFields(data, poiId) &&
        data.visibility == 'private' &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        (data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 200)) &&
        (data.ownerDisplayName == null || (data.ownerDisplayName is string && data.ownerDisplayName.size() <= 200)) &&
        data.sharedWith is list &&
        data.sharedWith.size() <= 50 &&
        data.sharedWithUids is list &&
        data.sharedWithUids.size() <= 50 &&
        data.sharedWithEmails is list &&
        data.sharedWithEmails.size() <= 50;
    }

    function validPoiOverride(data, poiId) {
      return data.keys().hasOnly([
          'id',
          'deleted',
          'category',
          'subcategory',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'deleted',
          'category',
          'subcategory',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.id == poiId &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.deleted is bool &&
        (data.category == null || (data.category is string && validPoiCategory(data.category))) &&
        (data.subcategory == null || (data.subcategory is string && data.subcategory.size() <= 64)) &&
        data.updatedByUid is string &&
        data.updatedByUid.size() > 0 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 64;
    }

    function annotationPath(trailId) {
      return /databases/$(database)/documents/trail_annotations/$(trailId);
    }

    function historyPath(trailId, historyId) {
      return /databases/$(database)/documents/trail_annotations/$(trailId)/history/$(historyId);
    }

    function validTrailSnapshot(data) {
      return data is map &&
        data.keys().hasOnly([
          'wayIds',
          'color',
          'name',
          'number',
          'description',
          'status',
          'geometryPath',
          'selectionReleaseId'
        ]) &&
        data.keys().hasAll([
          'wayIds',
          'color',
          'number',
          'description',
          'status',
          'geometryPath',
          'selectionReleaseId'
        ]) &&
        data.wayIds is list &&
        data.color is string &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        data.number is string &&
        data.description is string &&
        data.status in ['active', 'deleted'] &&
        data.geometryPath is string &&
        data.selectionReleaseId is string;
    }

    function validTrailAnnotation(data, trailId) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'wayIds',
          'color',
          'name',
          'number',
          'description',
          'status',
          'revision',
          'lastHistoryId',
          'geometryPath',
          'selectionReleaseId',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'schemaVersion',
          'wayIds',
          'color',
          'number',
          'description',
          'status',
          'revision',
          'lastHistoryId',
          'geometryPath',
          'selectionReleaseId',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.id == trailId &&
        data.schemaVersion == 1 &&
        data.wayIds is list &&
        data.wayIds.size() > 0 &&
        data.wayIds.size() <= 500 &&
        data.color in ['#dc2626', '#ea580c', '#ca8a04', '#16a34a', '#2563eb', '#7c3aed', '#334155'] &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        data.number is string &&
        data.number.size() <= 32 &&
        data.description is string &&
        data.description.size() <= 4000 &&
        data.status in ['active', 'deleted'] &&
        data.revision is int &&
        data.revision > 0 &&
        data.lastHistoryId is string &&
        data.lastHistoryId.matches('^[A-Za-z0-9_-]{16,64}$') &&
        data.geometryPath is string &&
        data.geometryPath.matches('^trail_annotations/' + trailId + '/geometry/[1-9][0-9]*-[A-Za-z0-9_-]{16,64}\\.json$') &&
        data.selectionReleaseId is string &&
        data.selectionReleaseId.size() > 0 &&
        data.selectionReleaseId.size() <= 256 &&
        data.createdByUid is string &&
        data.updatedByUid is string &&
        data.updatedAt == request.time;
    }

    function validHistoryPair(trailId, data, oldData, operation) {
      let history = getAfter(historyPath(trailId, data.lastHistoryId)).data;
      return existsAfter(historyPath(trailId, data.lastHistoryId)) &&
        history.keys().hasOnly([
          'revision',
          'operation',
          'actorUid',
          'occurredAt',
          'previous',
          'next',
          'reason'
        ]) &&
        history.revision == data.revision &&
        history.operation == operation &&
        history.actorUid == request.auth.uid &&
        history.occurredAt == request.time &&
        history.reason is string &&
        history.reason.size() <= 500 &&
        validTrailSnapshot(history.next) &&
        history.next.wayIds == data.wayIds &&
        history.next.color == data.color &&
        history.next.get('name', '') == data.get('name', '') &&
        history.next.number == data.number &&
        history.next.description == data.description &&
        history.next.status == data.status &&
        history.next.geometryPath == data.geometryPath &&
        history.next.selectionReleaseId == data.selectionReleaseId &&
        (oldData == null
          ? history.previous == null
          : validTrailSnapshot(history.previous) &&
            history.previous.wayIds == oldData.wayIds &&
            history.previous.color == oldData.color &&
            history.previous.get('name', '') == oldData.get('name', '') &&
            history.previous.number == oldData.number &&
            history.previous.description == oldData.description &&
            history.previous.status == oldData.status &&
            history.previous.geometryPath == oldData.geometryPath &&
            history.previous.selectionReleaseId == oldData.selectionReleaseId);
    }

    function validHistoryCreate(trailId, historyId) {
      let annotation = getAfter(annotationPath(trailId)).data;
      let existingAnnotation = get(annotationPath(trailId));
      let annotationExists = exists(annotationPath(trailId));
      let history = request.resource.data;
      return existsAfter(annotationPath(trailId)) &&
        annotation.lastHistoryId == historyId &&
        annotation.revision == history.revision &&
        annotation.updatedByUid == request.auth.uid &&
        validTrailSnapshot(history.next) &&
        history.next.wayIds == annotation.wayIds &&
        history.next.color == annotation.color &&
        history.next.get('name', '') == annotation.get('name', '') &&
        history.next.number == annotation.number &&
        history.next.description == annotation.description &&
        history.next.status == annotation.status &&
        history.next.geometryPath == annotation.geometryPath &&
        history.next.selectionReleaseId == annotation.selectionReleaseId &&
        (annotationExists
          ? validTrailSnapshot(history.previous) &&
            history.previous.wayIds == existingAnnotation.data.wayIds &&
            history.previous.color == existingAnnotation.data.color &&
            history.previous.get('name', '') == existingAnnotation.data.get('name', '') &&
            history.previous.number == existingAnnotation.data.number &&
            history.previous.description == existingAnnotation.data.description &&
            history.previous.status == existingAnnotation.data.status &&
            history.previous.geometryPath == existingAnnotation.data.geometryPath &&
            history.previous.selectionReleaseId == existingAnnotation.data.selectionReleaseId
          : history.previous == null);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /trail_annotations/{trailId} {
      allow get, list: if true;
      allow create: if signedIn() &&
        validTrailAnnotation(request.resource.data, trailId) &&
        request.resource.data.revision == 1 &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        validHistoryPair(trailId, request.resource.data, null, 'create');
      allow update: if signedIn() &&
        validTrailAnnotation(request.resource.data, trailId) &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        validHistoryPair(
          trailId,
          request.resource.data,
          resource.data,
          request.resource.data.status == 'deleted'
            ? 'delete'
            : resource.data.status == 'deleted'
              ? 'restore'
              : request.resource.data.wayIds != resource.data.wayIds
                ? 'rebind'
                : 'edit'
        );
      allow delete: if false;

      match /history/{historyId} {
        allow get, list: if true;
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'revision',
            'operation',
            'actorUid',
            'occurredAt',
            'previous',
            'next',
            'reason'
          ]) &&
          request.resource.data.revision is int &&
          request.resource.data.revision > 0 &&
          request.resource.data.operation in ['create', 'edit', 'delete', 'restore', 'rebind'] &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.occurredAt == request.time &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() <= 500 &&
          validHistoryCreate(trailId, historyId);
        allow update, delete: if false;
      }

      match /geometry/{geometryFile} {
        allow get, list: if true;
        allow create: if signedIn() &&
          geometryFile.matches('^[1-9][0-9]*-[A-Za-z0-9_-]{16,64}\\.json$') &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'releaseId', 'geometryJson']) &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.releaseId is string &&
          request.resource.data.releaseId.size() > 0 &&
          request.resource.data.releaseId.size() <= 256 &&
          request.resource.data.geometryJson is string &&
          request.resource.data.geometryJson.size() > 0 &&
          request.resource.data.geometryJson.size() <= 900000;
        allow update, delete: if false;
      }
    }

    function communityRoadPath(roadId) {
      return /databases/$(database)/documents/community_roads/$(roadId);
    }

    function communityRoadHistoryPath(roadId, historyId) {
      return /databases/$(database)/documents/community_roads/$(roadId)/history/$(historyId);
    }

    function validCommunityHighwayClass(cls) {
      return cls in [
        'motorway', 'trunk', 'primary', 'secondary', 'tertiary',
        'unclassified', 'residential', 'living_street', 'service',
        'track', 'path', 'footway', 'cycleway', 'bridleway',
        'pedestrian', 'steps'
      ];
    }

    function validCommunityRoad(data, roadId) {
      return roadId.matches('^[A-Za-z0-9_-]{8,128}$') &&
        data.keys().hasOnly([
          'schemaVersion',
          'kind',
          'sourceOsmWayId',
          'coordinates',
          'bounds',
          'highwayClass',
          'tracktype',
          'surface',
          'name',
          'description',
          'oneway',
          'allow4x4',
          'allowFoot',
          'allowBicycle',
          'anchors',
          'trailColor',
          'trailNumber',
          'trailName',
          'status',
          'revision',
          'lastHistoryId',
          'createdByUid',
          'createdAt',
          'updatedByUid',
          'updatedAt',
          'osmSync'
        ]) &&
        data.schemaVersion == 1 &&
        data.kind in ['new', 'osm-override'] &&
        (!('sourceOsmWayId' in data) || (data.sourceOsmWayId is string && data.sourceOsmWayId.matches('^osm:way:[1-9][0-9]*$'))) &&
        data.coordinates is list &&
        data.coordinates.size() >= 2 &&
        data.coordinates.size() <= 2000 &&
        data.bounds is list &&
        data.bounds.size() == 4 &&
        validCommunityHighwayClass(data.highwayClass) &&
        (!('tracktype' in data) || data.tracktype in ['', 'grade1', 'grade2', 'grade3', 'grade4', 'grade5']) &&
        (!('surface' in data) || (data.surface is string && data.surface.size() <= 40)) &&
        data.name is string &&
        data.name.size() <= 120 &&
        data.description is string &&
        data.description.size() <= 4000 &&
        data.oneway in [-1, 0, 1] &&
        data.allow4x4 is bool &&
        data.allowFoot is bool &&
        data.allowBicycle is bool &&
        (data.allow4x4 || data.allowFoot || data.allowBicycle) &&
        data.anchors is list &&
        (!('trailColor' in data) || data.trailColor in ['', '#dc2626', '#2563eb', '#16a34a', '#334155']) &&
        (!('trailNumber' in data) || (data.trailNumber is string && data.trailNumber.size() <= 32)) &&
        (!('trailName' in data) || (data.trailName is string && data.trailName.size() <= 120)) &&
        data.status in ['active', 'deleted'] &&
        data.revision is int &&
        data.revision >= 1 &&
        data.lastHistoryId is string &&
        data.lastHistoryId.matches('^[1-9][0-9]*-[A-Za-z0-9_-]{8,64}$') &&
        data.createdByUid is string &&
        data.createdByUid.size() > 0 &&
        data.createdByUid.size() <= 128 &&
        data.updatedByUid is string &&
        data.updatedByUid.size() > 0 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedAt == request.time;
    }

    function validCommunityRoadHistoryPair(roadId, nextRoad, prevRoad, expectedOp) {
      let historyDoc = getAfter(communityRoadHistoryPath(roadId, nextRoad.lastHistoryId)).data;
      return historyDoc.revision == nextRoad.revision &&
        historyDoc.operation == expectedOp &&
        historyDoc.actorUid == request.auth.uid &&
        historyDoc.occurredAt == request.time &&
        (prevRoad == null ? historyDoc.previous == null : historyDoc.previous is map);
    }

    match /community_roads/{roadId} {
      allow get, list: if true;
      allow create: if signedIn() &&
        validCommunityRoad(request.resource.data, roadId) &&
        request.resource.data.revision == 1 &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        validCommunityRoadHistoryPair(roadId, request.resource.data, null, 'create');
      allow update: if signedIn() &&
        validCommunityRoad(request.resource.data, roadId) &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        validCommunityRoadHistoryPair(
          roadId,
          request.resource.data,
          resource.data,
          request.resource.data.status == 'deleted'
            ? 'delete'
            : resource.data.status == 'deleted'
              ? 'restore'
              : 'edit'
        );
      allow delete: if false;

      match /history/{historyId} {
        allow get, list: if true;
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'revision',
            'operation',
            'actorUid',
            'occurredAt',
            'previous',
            'next',
            'reason'
          ]) &&
          request.resource.data.revision is int &&
          request.resource.data.revision > 0 &&
          request.resource.data.operation in ['create', 'edit', 'delete', 'restore', 'osm-sync'] &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.occurredAt == request.time &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() <= 500 &&
          existsAfter(communityRoadPath(roadId)) &&
          getAfter(communityRoadPath(roadId)).data.lastHistoryId == historyId;
        allow update, delete: if false;
      }
    }

    match /planing_tracks/{userId}/routes/{routeId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid in resource.data.sharedWithUids ||
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );
    }

    match /{path=**}/routes/{routeId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.sharedWithUids ||
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );
    }

    match /global_pois/{poiId} {
      allow get, list: if true;
      allow create: if signedIn() &&
        validGlobalPoi(request.resource.data, poiId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow update: if signedIn() &&
        validGlobalPoi(request.resource.data, poiId) &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isPoiDeleteAdmin();
    }

    match /private_pois/{poiId} {
      allow get, list: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.sharedWithUids ||
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );
      allow create: if signedIn() &&
        validPrivatePoi(request.resource.data, poiId) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow update: if signedIn() &&
        validPrivatePoi(request.resource.data, poiId) &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /poi_overrides/{poiId} {
      allow get, list: if true;
      allow create: if validPoiOverride(request.resource.data, poiId) &&
        request.resource.data.updatedByUid == request.auth.uid &&
        (request.resource.data.deleted == true
          ? isPoiDeleteAdmin()
          : signedIn() && request.resource.data.category != null);
      allow update: if validPoiOverride(request.resource.data, poiId) &&
        request.resource.data.updatedByUid == request.auth.uid &&
        ((request.resource.data.deleted == true || resource.data.deleted == true)
          ? isPoiDeleteAdmin()
          : signedIn());
      allow delete: if isPoiDeleteAdmin();
    }

    match /planing_tracks/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function validLiveLocation(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'visibility',
          'active',
          'sharedWith',
          'sharedWithUids',
          'sharedWithEmails',
          'lon',
          'lat',
          'accuracy',
          'altitude',
          'heading',
          'speed',
          'iconId',
          'accentColor',
          'startedAt',
          'updatedAt',
          'expiresAt',
          'expiresAtMs'
        ]) &&
        data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'visibility',
          'active',
          'sharedWith',
          'sharedWithUids',
          'sharedWithEmails',
          'lon',
          'lat',
          'accuracy',
          'altitude',
          'heading',
          'speed',
          'iconId',
          'accentColor',
          'startedAt',
          'updatedAt',
          'expiresAt',
          'expiresAtMs'
        ]) &&
        data.uid == uid &&
        data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 200 &&
        (data.email == null || (data.email is string && data.email.size() <= 200)) &&
        (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.visibility in ['off', 'shared', 'public'] &&
        data.active is bool &&
        data.sharedWith is list &&
        data.sharedWith.size() <= 50 &&
        data.sharedWithUids is list &&
        data.sharedWithUids.size() <= 50 &&
        data.sharedWithEmails is list &&
        data.sharedWithEmails.size() <= 50 &&
        (data.lon is int || data.lon is float) &&
        data.lon >= -180 &&
        data.lon <= 180 &&
        (data.lat is int || data.lat is float) &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        (data.accuracy == null || data.accuracy is int || data.accuracy is float) &&
        (data.altitude == null || data.altitude is int || data.altitude is float) &&
        (data.heading == null || data.heading is int || data.heading is float) &&
        (data.speed == null || data.speed is int || data.speed is float) &&
        data.iconId is string &&
        data.iconId.size() > 0 &&
        data.iconId.size() <= 128 &&
        data.accentColor is string &&
        data.accentColor.size() > 0 &&
        data.accentColor.size() <= 32 &&
        data.startedAt is string &&
        data.startedAt.size() > 0 &&
        data.startedAt.size() <= 64 &&
        data.updatedAt is string &&
        data.updatedAt.size() > 0 &&
        data.updatedAt.size() <= 64 &&
        (data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        (data.expiresAtMs == null || data.expiresAtMs is int || data.expiresAtMs is float);
    }

    match /live_locations/{uid} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.visibility == 'public' ||
        request.auth.uid in resource.data.sharedWithUids ||
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        validLiveLocation(request.resource.data, uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
