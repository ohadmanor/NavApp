rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trail_annotations/{trailId}/geometry/{geometryFile} {
      allow read: if true;
      allow create: if request.auth != null &&
        resource == null &&
        geometryFile.matches('^[1-9][0-9]*-[A-Za-z0-9_-]{16,64}\\.json$') &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType == 'application/json' &&
        request.resource.metadata.trailId == trailId;
      allow update, delete: if false;
    }

    match /planing_tracks/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
